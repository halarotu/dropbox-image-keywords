{
  "name": "dropbox-image-keywords",
  "version": "0.1.0",
  "private": true,
  "description": "Scheduled job that finds new images in Dropbox, extracts keywords with a vision model and stores them in Firestore.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js run",
    "scan": "node dist/index.js scan",
    "process": "node dist/index.js process",
    "api": "node dist/api/index.js",
    "dev": "tsx --env-file=.env src/index.ts run",
    "dev:api": "API_AUTH=none WEB_DIST_DIR=web/dist tsx watch --env-file=.env src/api/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "dropbox:token": "tsx scripts/get-dropbox-refresh-token.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@hono/node-server": "^2.1.6",
    "dropbox": "^10.47.0",
    "google-auth-library": "^11.3.2",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
