# --- Dropbox (scoped app: files.metadata.read + files.content.read) ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Get one with: npm run dropbox:token
DROPBOX_REFRESH_TOKEN=
# Comma-separated folders to watch; empty = whole Dropbox (or the app folder for app-folder apps)
DROPBOX_ROOTS=/Photos,/Camera Uploads
IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp,tif,tiff,bmp

# --- Firestore ---
# Locally: run `gcloud auth application-default login` first. Omit on Cloud Run.
GCP_PROJECT_ID=my-gcp-project
FIRESTORE_DATABASE_ID=(default)

# --- Keyword provider ---
KEYWORD_PROVIDER=ollama
# Locally: run Ollama yourself (http://localhost:11434), or tunnel to the Cloud Run service with
#   gcloud run services proxy ollama --region europe-west1 --port 11434
LLM_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
# none | google-id-token (use google-id-token on Cloud Run when calling the authenticated service)
LLM_AUTH=none
LLM_TIMEOUT_SECONDS=180
KEYWORD_LANGUAGE=English
MAX_KEYWORDS=20

# --- Worker ---
BATCH_SIZE=50
CONCURRENCY=3
MAX_ATTEMPTS=5
REPROCESS_ON_CHANGE=true
LOCK_LEASE_MINUTES=30
